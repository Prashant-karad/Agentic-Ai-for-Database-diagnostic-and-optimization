# Copy this file to .env and put real values there.
# .env is git-ignored; this example file is safe to commit.

# Database login (used by Docker to create the databases)
POSTGRES_USER=dbagent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=shop


# LLM (OpenAI-compatible API). Get a key at console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=put-your-key-here
LLM_MODEL=model-name-here